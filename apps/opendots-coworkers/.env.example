# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every value is optional and read server-side only (/api/agent and the page) — never shipped to the browser.
# With no key the playground runs fully in Scripted mode: canned tasks in data/, simulated computers, zero network calls.

# Enables Live mode: Claude writes the Writer's page body, still streamed as AG-UI events.
# Tool calls stay simulated and pass the same server-side permission gate.
ANTHROPIC_API_KEY=

# Required only for keys NOT scoped to a single workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional effort override (default: low)
ANTHROPIC_EFFORT=
