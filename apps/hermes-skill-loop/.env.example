# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every value is optional and read server-side only (/api/loop) — never shipped to the browser.
# With no key the studio runs the scripted harness: canned runs + skills from data/tasks.ts.

# Enables Live mode: Claude runs each task in a simulated sandbox and distils the skill.
ANTHROPIC_API_KEY=

# Required only for keys NOT scoped to a single workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional effort override (default: low)
ANTHROPIC_EFFORT=
