# Copy to .env (or export in your shell) and restart `bun run dev`.
# Read server-side only (Vite dev middleware / Vercel /api); never reaches the browser.
# Without a key the studio runs in sample mode: seeds, keyword matches and
# arrow sketches all render offline from local IR.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only for keys that are NOT scoped to a single workspace.
# Claude Console → Settings → Workspaces. Example: wrkspc_01JwQvzr7rXLA5AGx3HKfFUJ
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-sonnet-5)
ANTHROPIC_MODEL=
