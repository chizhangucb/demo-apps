# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every key is optional and read server-side only (/api routes) — never shipped to the browser.
# With no keys the studio runs the scripted path: canned tool hits, Jev judgments and agent notes.

# Live Jev judge (route node). Precedence: OPENROUTER_API_KEY > TYPESAFE_API_KEY.
# Jev via OpenRouter — no TypeSafe waitlist: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Direct TypeSafe key (read by @parcha/agentrun-jev / @typesafe-ai/sdk).
TYPESAFE_API_KEY=

# Live investigate agent (agent node) via Anthropic.
ANTHROPIC_API_KEY=
# Only for multi-workspace keys: sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
# Optional model override (default claude-sonnet-5).
ANTHROPIC_MODEL=
