# Copy to .env (or export in your shell) and restart `bun run dev`.
# Keys are read server-side only and never reach the browser.
#
# Precedence: OPENROUTER_API_KEY > TYPESAFE_API_KEY > built-in sample heuristics.

# Jev via OpenRouter — no TypeSafe waitlist needed.
# Get a key at https://openrouter.ai/keys
# Docs: https://openrouter.ai/docs/guides/community/typesafe-sdk
OPENROUTER_API_KEY=

# Direct TypeSafe API key (currently waitlisted). Optional if using OpenRouter.
TYPESAFE_API_KEY=
