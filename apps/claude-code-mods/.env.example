# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every value is optional and read server-side only (/api/suggest, /api/status) — never shipped to the browser.
# With no key the playground runs fully: mods execute in a sandboxed Web Worker against seeded events in data/.

# Enables "Suggest a mod with Claude": Claude drafts a register(on) module for the selected event.
ANTHROPIC_API_KEY=

# Required only for keys NOT scoped to a single workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional effort override (default: low)
ANTHROPIC_EFFORT=
