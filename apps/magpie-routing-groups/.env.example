# Nothing is required. The playground runs in Scripted mode with zero secrets, locally and on Vercel.
# Every value below is optional, read server-side only (/api/live), and uses the same names as
# apps/claude-agent-loops. Never add new secret names for this app.

# Enables "Live reply" on the selected turn: one short reply written by Claude
# (max 3 calls per run, small output budget, falls back to the scripted reply on any error).
ANTHROPIC_API_KEY=

# Required only for keys NOT scoped to a single workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional effort override (default: low)
ANTHROPIC_EFFORT=
