# Copy to .env (or export in your shell) and restart `bun run dev`.
# Read server-side only; never reaches the browser.
# Without it the app runs in mock mode (canned tool flows over the same mock catalog).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required when the API key is NOT scoped to a single workspace (identity-linked /
# multi-workspace keys). Sent as the anthropic-workspace-id header on every Messages
# call. Find the ID in Claude Console → Settings → Workspaces. Omit for workspace-scoped keys.
# Example: wrkspc_01JwQvzr7rXLA5AGx3HKfFUJ
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-sonnet-5)
ANTHROPIC_MODEL=

# Optional effort override for adaptive thinking (default: medium)
ANTHROPIC_EFFORT=
