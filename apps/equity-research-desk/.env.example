# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every value is optional and read server-side only (/api/research). Never shipped to the browser.
# With no key the desk loads the bundled SAMPLE run (SMCI, cached EDGAR) and works with zero secrets.

# Enables live runs: SEC EDGAR fetch + Claude sets assumptions and writes the nine chapters.
ANTHROPIC_API_KEY=

# Required only for keys NOT scoped to a single workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Optional effort override (default: low)
ANTHROPIC_EFFORT=
