# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every key is optional and read server-side only (/api routes) — never shipped to the browser.
# With no keys the harness runs scripted: canned Jev probabilities and verdicts, zero network.

# Live Jev for the three gates. Precedence: OPENROUTER_API_KEY > TYPESAFE_API_KEY.
# Jev via OpenRouter — no TypeSafe waitlist: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Direct TypeSafe key. Used only if OPENROUTER_API_KEY is unset.
TYPESAFE_API_KEY=
