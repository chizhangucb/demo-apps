# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every value is optional and read server-side only (/api/step) — never shipped to the browser.
# With no key the studio runs the scripted harness: canned Act steps + the real local rule verifier.

# Enables Live mode: Claude takes each Act step and judges criteria the local rules can't check.
ANTHROPIC_API_KEY=

# Required only for keys NOT scoped to a single workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional effort override (default: low — each loop step is small)
ANTHROPIC_EFFORT=
