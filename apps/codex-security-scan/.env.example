# Copy to .env.local (or set in Vercel) and restart `bun run dev`.
# Every value is optional and read server-side only (/api routes) — never shipped to the browser.
# With no keys the studio runs the scripted path: canned findings for both targets, with
# snippets re-verified against the bundled sample and a fresh public chronicle checkout.

# Live Codex Security scans + live patch validation (@openai/codex-security, auth: "api-key").
# CODEX_API_KEY is accepted as an alternative. Live mode also needs Python 3.10+ and git on the host.
OPENAI_API_KEY=
# Stop a live scan once estimated model cost passes this many USD (default 2).
CODEX_SECURITY_MAX_COST_USD=

# Optional: where the public chizhangucb/chronicle archive is unpacked (default: OS tmpdir).
CHRONICLE_CACHE_DIR=
# Optional: Codex Security state directory (default: OS tmpdir/codex-security-state).
CODEX_SECURITY_STATE_DIR=
# Optional: Python interpreter for Codex Security (default: python3).
PYTHON=
