# All optional. With none set the lab runs fully on the three official presets and shows Live as unavailable.
# Server only: never exposed to the browser.
ANTHROPIC_API_KEY=
# Only for multi-workspace or identity-linked keys.
ANTHROPIC_WORKSPACE_ID=
# Default claude-sonnet-5-5.
ANTHROPIC_MODEL=
# low | medium | high | xhigh | max. Default low.
ANTHROPIC_EFFORT=
